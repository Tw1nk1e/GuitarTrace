# Пример переменных окружения. Сам файл .env автоматически не загружается:
# задайте переменные в оболочке или в настройках запуска сервиса.
# Слушать только локальный компьютер (не открывайте сервис в интернет без защиты)
GBCV_HOST=127.0.0.1
# Необязательно: без GBCV_PORT выбирается свободный порт начиная с 8000
# GBCV_PORT=8000
# Лимиты на входное фото
GBCV_MAX_FILE_MB=25
GBCV_MAX_MEGAPIXELS=40
# Необязательно: каталог весов BiRefNet; пока не применяется к SAM
# GBCV_MODEL_DIR=C:/path/to/models
